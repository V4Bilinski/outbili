# ============================================
# OUTBILI — Variáveis do App (Vite)
# ============================================
# Copie para .env.local e preencha os valores reais.
# NÃO commite .env.local.
# ============================================

# --- Airtable (fonte de dados) ---
VITE_AIRTABLE_PAT=
VITE_AIRTABLE_BASE_ID=

# --- CNPJá (fonte cadastral primária) ---
VITE_CNPJA_API_KEY=

# --- Assertiva (enriquecimento telefones, redes sociais, decisores) ---
VITE_ASSERTIVA_CLIENT_ID=
VITE_ASSERTIVA_CLIENT_SECRET=
VITE_ASSERTIVA_WORKER_URL=
VITE_N8N_ASSERTIVA_PROXY=
VITE_N8N_WEBHOOK_URL=

# --- Firecrawl (FALLBACK de redes sociais quando Assertiva vazia) ---
# Obtenha em https://firecrawl.dev — free tier: 500 scrapes/mês
# Sem isso, pipeline degrada para só-Assertiva (graceful)
VITE_FIRECRAWL_API_KEY=

# --- Apify (scraping geral) ---
VITE_APIFY_TOKEN=

# --- BilinskiZap (envio WhatsApp) ---
VITE_BILINSKIZAP_API_KEY=
VITE_BILINSKIZAP_URL=

# --- GitHub (para publicação e deploy) ---
VITE_GITHUB_TOKEN=
